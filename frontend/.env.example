# ARGUS AI — Frontend Environment Variables (Vite)
# Copy this template to frontend/.env.local for local overrides.
# NOTE: Never commit .env or .env.local with real keys.
#
# IMPORTANT SECURITY NOTICE:
# Firebase Web API keys are delivered to the browser and are client-visible by design.
# Moving the key to an environment variable prevents accidental source-code commits,
# but does NOT make the key confidential.
# Production security MUST be enforced via:
# 1. Google Cloud Console API Restrictions: Restrict the browser Firebase key to only the
#    Firebase-related APIs actually required by ARGUS. Verify unrelated Google APIs such
#    as Gemini / Generative Language API are not allowed.
# 2. HTTP Referrer Restrictions: Restrict key usage to authorized domain names/origins in production.
# 3. Firebase Security Rules: Enforce authentication and role-based data access in Firestore & Storage.
# 4. Firebase App Check: Attest client authenticity.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key_placeholder
VITE_FIREBASE_AUTH_DOMAIN=argus-17702.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=argus-17702
VITE_FIREBASE_STORAGE_BUCKET=argus-17702.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=178416740087
VITE_FIREBASE_APP_ID=your_firebase_app_id_placeholder

# Optional API endpoints
# VITE_GAIT_API_URL=http://localhost:8000
# VITE_API_URL=http://localhost:8000
# VITE_FACE_API_URL=http://localhost:8000
