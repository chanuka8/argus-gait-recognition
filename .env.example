ARGUS_MODE=inference
ARGUS_DEVICE=cpu
ARGUS_CAMERA_INDEX=0
ARGUS_CONFIDENCE_THRESHOLD=0.50
ARGUS_MATCH_THRESHOLD=0.75
ARGUS_ENABLE_API=false
ARGUS_ENABLE_AUTO_TRAIN=false

# RTSP Camera Credentials (Priority 1)
# ARGUS_CAMERA_01_USERNAME=admin
# ARGUS_CAMERA_01_PASSWORD=secret_password
# ARGUS_CAMERA_02_USERNAME=admin
# ARGUS_CAMERA_02_PASSWORD=secret_password

# Encrypted Local Credential Store Key (Priority 2)
# ARGUS_CREDENTIAL_ENCRYPTION_KEY=your_fernet_or_passphrase_key
# ARGUS_CREDENTIALS_KEY=your_fernet_or_passphrase_key
# ARGUS_CREDENTIALS_FILE=configs/credentials.enc

# Legacy Plaintext Credentials Fallback (Priority 3 - Disabled by default)
# ARGUS_LEGACY_ALLOW_PLAINTEXT_CREDS=false

# Firebase Admin SDK Service Account Configuration (Optional - Defaults to offline mode if unconfigured)
# Preferred environment variable:
# FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
# Fallback environment variable:
# GOOGLE_APPLICATION_CREDENTIALS=config/firebase-service-account.json

# Deployment Environment & Camera Transport Security (U4)
# Canonical deployment environment (precedence: override -> ARGUS_ENVIRONMENT -> configs/production.yaml -> development)
# ARGUS_ENVIRONMENT=development
# Strict camera transport enforcement (true in production by default, or explicitly enabled)
# ARGUS_REQUIRE_SECURE_CAMERA_TRANSPORT=true
# Optional operator confirmation for RTSPS candidate streams without native PKI
# ARGUS_ALLOW_RTSPS_CANDIDATE=false
